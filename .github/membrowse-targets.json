[
  {
    "target_name": "CubeOrange-copter",
    "setup_cmd": "git config --global --add safe.directory $GITHUB_WORKSPACE && echo \"PATH=/usr/lib/ccache:/opt/gcc-arm-none-eabi-10/bin:/github/home/.local/bin:$PATH\" >> $GITHUB_ENV",
    "build_cmd": "./waf configure --board CubeOrange && ./waf copter",
    "elf": "build/CubeOrange/bin/arducopter",
    "ld": "build/CubeOrange/ldscript.ld build/CubeOrange/common.ld",
    "map_file": "build/CubeOrange/Linker.map",
    "linker_vars": "__main_stack_size__=0x600 __process_stack_size__=0x1C00",
    "skip_sections": ".heap .crash_log"
  },
